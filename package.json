{
  "name": "sentinel-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm lint && next dev --inspect",
    "dev:secure": "pnpm lint && next dev --inspect --experimental-https",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "pnpm typecheck && biome lint .",
    "lint:fix": "pnpm typecheck && biome lint . --write",
    "pret": "biome format .",
    "pret:fix": "biome format . --write",
    "biome": "pnpm typecheck && biome check . --max-diagnostics=100",
    "biome:fix": "pnpm typecheck && biome check . --write --max-diagnostics=100",
    "biome:summary": "biome check . --reporter=summary --max-diagnostics=100",
    "prepare": "husky",
    "preinstall": "npx --yes only-allow@1.2.1 pnpm"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.575.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "^9.1.7",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.1"
}
